# ==========================================
# PARADOX — AI PROVIDERS
# ==========================================
#
# Copy this file to `.env.local` and fill in the keys you have.
# The app runs with any subset: a provider with no key is skipped by the router
# and the remaining providers answer. Never commit real keys.
#
# Docs: docs/ai-providers.md
#
# After changing any value, restart the dev server (`npm run dev`) — Next.js
# reads env files at boot. On a deployment platform, set the same variables in
# the platform's environment settings; `.env.local` is not uploaded anywhere.

# OpenRouter — Primary AI provider
# https://openrouter.ai/keys  (free models: 50 requests/day, 1000/day with 10 credits)
OPENROUTER_API_KEY=

# Optional: a stronger OpenRouter model appended to every ladder. Naming one here
# is the explicit authorization to use a paid model as the last resort.
# OPENROUTER_BACKSTOP_MODEL=

# Google Gemini API — General AI and vision fallback
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Cerebras Inference — Fast inference fallback
# https://cloud.cerebras.ai/  (API keys, free trial credits)
CEREBRAS_API_KEY=

# Groq — Fast inference and text fallback
# https://console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI — Auxiliary AI tasks
# Token needs the "Workers AI: Read" permission.
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==========================================
# PARADOX — AI ROUTING (optional)
# ==========================================
#
# Default order: openrouter,gemini,cerebras,groq,cloudflare
# PARADOX_PROVIDER_ORDER=openrouter,gemini,cerebras,groq,cloudflare
#
# Comma-separated providers to skip without deleting their keys.
# PARADOX_DISABLED_PROVIDERS=
#
# Put a specific model first for a role: `provider:model`. Roles: GENERAL, FAST,
# CODE, REASONER, CREATIVE, VISION, EVALUATOR.
# PARADOX_MODEL_GENERAL=gemini:gemini-3.8-flash
#
# Paid endpoints stay off unless this is explicitly "true" (the OpenRouter
# backstop above is its own opt-in).
# PARADOX_ALLOW_PAID_MODELS=false
#
# Retry budget for one request, and retries of the same model on transient
# failures (429 burst, 5xx, network).
# PARADOX_AI_MAX_PROVIDER_CALLS=6
# PARADOX_AI_MAX_RETRIES=1
#
# Cooldowns after a provider signal (milliseconds).
# PARADOX_COOLDOWN_RATE_LIMIT_MS=30000
# PARADOX_COOLDOWN_QUOTA_MS=3600000
# PARADOX_COOLDOWN_OUTAGE_MS=60000
# PARADOX_COOLDOWN_UNSUPPORTED_MS=600000

# ==========================================
# PARADOX — EXISTING SETTINGS
# ==========================================
# These are used by the rest of the app. They are listed so this file is a
# complete template; keep whatever values your environment already has.
# Pooled connection for application traffic (see db/index.ts)
DATABASE_URL=
# Direct connection for migrations, which need a session (scripts/apply-migration.mjs)
DATABASE_URL_UNPOOLED=
CLERK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
TRIGGER_SECRET_KEY=

# Cloud browser (Godfather's "navegador cloud" route). Both are required; without
# them the cloud route is reported as unavailable and never simulated.
# https://www.browserbase.com/settings
# Docs: docs/godfather-browser.md
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# The local browser route needs no server key: it runs inside Paradox Desktop
# Agent on the person's machine. Optional, machine-side only:
# PARADOX_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ==========================================
# PARADOX — DESKTOP AGENT RELEASES
# ==========================================
# Which installer /api/desktop/download offers. Unset means "production":
# only an officially published, signed release can ever be served.
# Set it to `development` to try a local ParadoxSetup-dev.exe build. Never set
# `development` on a public deployment: that would advertise a test build.
# PARADOX_DESKTOP_CHANNEL=production
#
# The build machine (not the server) uses these, when building a release:
# PARADOX_BUILD_CHANNEL=development|production
# PARADOX_API_URL=https://the-server-the-agent-connects-to
# PARADOX_SIGN_PFX=path\to\certificate.pfx
# PARADOX_SIGN_PASSWORD=
# PARADOX_SIGN_THUMBPRINT=
# PARADOX_SIGN_PUBLISHER=CN=Your Company, O=Your Company
# Docs: desktop/README.md
# Resend — outbound email: the automation's send-email node and Godfather's
# email_send tool both go through lib/resend.ts. Defaults to Resend's test
# domain; set RESEND_FROM to the domain you verified to send for real.
RESEND_API_KEY=
RESEND_FROM=
ZERNIO_API_KEY=

# ==========================================
# PARADOX — INTEGRATION CENTRE
# ==========================================
#
# Key used to encrypt the credentials a person stores in Settings → Integrations
# (custom APIs and MCP servers). AES-256-GCM; the key never reaches the database,
# the browser or a log.
#
# Generate one and paste it here (base64 or 64-char hex, 32 bytes):
#   openssl rand -base64 32
#
# Without it, saving a credential is refused — there is deliberately no
# plaintext fallback. Rotating it makes previously stored credentials
# unreadable: they must be entered again.
INTEGRATIONS_ENCRYPTION_KEY=
