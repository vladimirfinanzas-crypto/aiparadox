    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "desktop:dev": "python pc-agent/agent.py --api http://localhost:3000",
    "desktop:test": "python -m unittest discover -s desktop/tests -t desktop -v",
    "desktop:build": "python desktop/package.py --channel development --no-publish",
    "desktop:package": "python desktop/package.py --channel development",
    "desktop:release": "python desktop/package.py --channel production",
    "desktop:verify": "python desktop/verify.py --channel development",
    "desktop:verify:release": "python desktop/verify.py --channel production"
